# .env file for MasterHttpRelay
# Copy this to .env and change the values

# Required: Pre-Shared Key for authentication
PSK=sajad1742@#!!9asdasdasd

# Optional: Environment name
ENVIRONMENT=production

# Optional: Timeout in milliseconds (default: 30000)
TIMEOUT_MS=30000

# Optional: Maximum retry count (default: 3)
MAX_RETRY_COUNT=3

# Optional: Enable debug logging (true/false)
ENABLE_DEBUG=false

# Optional: Custom version string
VERSION=2.0.0-beta

# Optional: Custom funny error messages (comma separated)
FUNNY_ERRORS="Something went sidewise,The gremlins are at it again,Try turning it off and on again,404: Sense of humor not found"

# Optional: Custom headers to strip (comma separated, case insensitive)
STRIP_HEADERS=host,connection,content-length,transfer-encoding,proxy-connection,proxy-authorization,x-forwarded-for,x-forwarded-host,x-forwarded-proto,x-forwarded-port,x-real-ip,forwarded,via
